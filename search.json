[{% assign first = true %}{% for section in site.data.nav %}{% for item in section.pages %}{% assign p = site.pages | where: "url", item.url | first %}{% if p %}{% assign raw = p.content | split: site.liquid_open %}{% capture clean %}{% for part in raw %}{% if forloop.first %}{{ part }}{% else %}{{ part | split: site.liquid_close | last }}{% endif %}{% endfor %}{% endcapture %}{% unless first %},{% endunless %}{% assign first = false %}
{"title": {{ p.title | jsonify }}, "url": {{ p.url | jsonify }}, "section": {{ section.title | jsonify }}, "keywords": {{ p.keywords | join: " " | jsonify }}, {% if p.layout == "home" %}{% assign clean = p.description %}{% endif %}"text": {{ p.lead | append: " " | append: clean | markdownify | strip_html | normalize_whitespace | truncatewords: 1200, "" | jsonify }}}{% endif %}{% endfor %}{% endfor %}
]
